{
  "additionalProperties": false,
  "properties": {
    "config_fname": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config Fname"
    },
    "debug": {
      "default": false,
      "title": "Debug",
      "type": "boolean"
    },
    "max_db_workers": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Db Workers"
    },
    "max_evaluation_jobs": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Evaluation Jobs"
    },
    "max_proposal_jobs": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Proposal Jobs"
    },
    "mode": {
      "const": "SHINKA_NATIVE",
      "default": "SHINKA_NATIVE",
      "title": "Mode",
      "type": "string"
    },
    "num_generations": {
      "exclusiveMinimum": 0,
      "title": "Num Generations",
      "type": "integer"
    },
    "results_dir": {
      "format": "path",
      "title": "Results Dir",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "set_overrides": {
      "items": {
        "type": "string"
      },
      "title": "Set Overrides",
      "type": "array"
    },
    "task_dir": {
      "format": "path",
      "title": "Task Dir",
      "type": "string"
    },
    "verbose": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verbose"
    }
  },
  "required": [
    "run_id",
    "task_dir",
    "results_dir",
    "num_generations"
  ],
  "title": "SearchRunRequest",
  "type": "object"
}
