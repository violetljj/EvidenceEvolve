{
  "$defs": {
    "AcquisitionSignals": {
      "additionalProperties": false,
      "properties": {
        "admit_probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Admit Probability",
          "type": "number"
        },
        "estimated_cost": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Estimated Cost",
          "type": "number"
        },
        "expected_improvement": {
          "title": "Expected Improvement",
          "type": "number"
        },
        "information_gain": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Information Gain",
          "type": "number"
        },
        "novelty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Novelty",
          "type": "number"
        },
        "redundancy": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Redundancy",
          "type": "number"
        },
        "transfer_value": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Transfer Value",
          "type": "number"
        }
      },
      "required": [
        "admit_probability",
        "expected_improvement",
        "information_gain",
        "novelty"
      ],
      "title": "AcquisitionSignals",
      "type": "object"
    },
    "CandidateAcquisition": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "$ref": "#/$defs/CandidateGenome"
        },
        "signals": {
          "$ref": "#/$defs/AcquisitionSignals"
        },
        "verified_reopen_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Verified Reopen Conditions",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "candidate",
        "signals"
      ],
      "title": "CandidateAcquisition",
      "type": "object"
    },
    "CandidateGenome": {
      "additionalProperties": false,
      "properties": {
        "ablation_plan": {
          "items": {
            "type": "string"
          },
          "title": "Ablation Plan",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "behavior_descriptor": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Behavior Descriptor",
          "type": "object"
        },
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,127}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "editable_files": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Editable Files",
          "type": "array"
        },
        "estimated_cost_tier": {
          "maximum": 5,
          "minimum": 0,
          "title": "Estimated Cost Tier",
          "type": "integer"
        },
        "estimated_information_value": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Estimated Information Value",
          "type": "number"
        },
        "expected_signature": {
          "$ref": "#/$defs/ExpectedSignature"
        },
        "failure_risks": {
          "items": {
            "type": "string"
          },
          "title": "Failure Risks",
          "type": "array"
        },
        "falsifier": {
          "minLength": 8,
          "title": "Falsifier",
          "type": "string"
        },
        "family": {
          "title": "Family",
          "type": "string"
        },
        "hypothesis": {
          "minLength": 12,
          "title": "Hypothesis",
          "type": "string"
        },
        "intervention": {
          "minLength": 8,
          "title": "Intervention",
          "type": "string"
        },
        "island": {
          "title": "Island",
          "type": "string"
        },
        "mechanism_claims": {
          "items": {
            "type": "string"
          },
          "title": "Mechanism Claims",
          "type": "array"
        },
        "mutation_type": {
          "$ref": "#/$defs/MutationType"
        },
        "parent_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Parent Ids",
          "type": "array"
        },
        "reopen_condition_claims": {
          "items": {
            "type": "string"
          },
          "title": "Reopen Condition Claims",
          "type": "array"
        },
        "required_controls": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Controls",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "search_abstraction": {
          "$ref": "#/$defs/SearchAbstraction",
          "default": "direct_solution"
        },
        "transfer_motifs": {
          "items": {
            "type": "string"
          },
          "title": "Transfer Motifs",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "parent_ids",
        "island",
        "family",
        "mutation_type",
        "hypothesis",
        "intervention",
        "expected_signature",
        "falsifier",
        "required_controls",
        "editable_files",
        "estimated_cost_tier"
      ],
      "title": "CandidateGenome",
      "type": "object"
    },
    "ExpectedSignature": {
      "additionalProperties": false,
      "properties": {
        "improve": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Improve",
          "type": "array"
        },
        "unchanged": {
          "items": {
            "type": "string"
          },
          "title": "Unchanged",
          "type": "array"
        }
      },
      "required": [
        "improve"
      ],
      "title": "ExpectedSignature",
      "type": "object"
    },
    "MutationType": {
      "enum": [
        "mechanism_mutation",
        "representation_mutation",
        "failure_directed_mutation",
        "control_mutation",
        "simplification",
        "cross_family",
        "restart"
      ],
      "title": "MutationType",
      "type": "string"
    },
    "ResearchStage": {
      "enum": [
        "P0_PROTOCOL_LOCK",
        "M0_MECHANICS",
        "H0_REAL_HEADROOM",
        "T0_LEARNED_CANDIDATE",
        "C0_CONFIRMATION",
        "D0_DEPLOYMENT"
      ],
      "title": "ResearchStage",
      "type": "string"
    },
    "SearchAbstraction": {
      "enum": [
        "direct_solution",
        "constructor",
        "heuristic",
        "search_algorithm",
        "representation",
        "loss_function",
        "optimizer",
        "data_selection_policy",
        "uncertainty_rule",
        "system_schedule",
        "hybrid_pipeline"
      ],
      "title": "SearchAbstraction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acquisition": {
      "$ref": "#/$defs/CandidateAcquisition"
    },
    "reference_metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Reference Metrics",
      "type": "object"
    },
    "stage": {
      "$ref": "#/$defs/ResearchStage",
      "default": "M0_MECHANICS"
    }
  },
  "required": [
    "acquisition"
  ],
  "title": "CampaignCandidate",
  "type": "object"
}
