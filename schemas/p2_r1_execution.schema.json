        "block",
        "arm",
        "slot",
        "paired_local_seed",
        "model",
        "transport_attempt_count",
        "transport_attempt_payload_sha256s",
        "terminal_funnel_state",
        "state_namespace",
        "executor_commit",
        "protocol_sha256"
