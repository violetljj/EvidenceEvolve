{
  "$defs": {
    "ArmRun": {
      "additionalProperties": false,
      "properties": {
        "arm": {
          "enum": [
            "official",
            "native"
          ],
          "title": "Arm",
          "type": "string"
        },
        "baseline_score": {
          "title": "Baseline Score",
          "type": "number"
        },
        "block": {
          "maximum": 10,
          "minimum": 1,
          "title": "Block",
          "type": "integer"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "evaluator_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evaluator Sha256",
          "type": "string"
        },
        "initial_incumbent_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Initial Incumbent Sha256",
          "type": "string"
        },
        "initial_program_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Initial Program Sha256",
          "type": "string"
        },
        "observed_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Cost"
        },
        "observed_input_tokens": {
          "minimum": 0,
          "title": "Observed Input Tokens",
          "type": "integer"
        },
        "observed_output_tokens": {
          "minimum": 0,
          "title": "Observed Output Tokens",
          "type": "integer"
        },
        "resume_consistent": {
          "title": "Resume Consistent",
          "type": "boolean"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/ProposalSlot"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Slots",
          "type": "array"
        },
        "state_namespace": {
          "title": "State Namespace",
          "type": "string"
        },
        "wall_seconds": {
          "minimum": 0.0,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "required": [
        "block",
        "arm",
        "baseline_score",
        "initial_program_sha256",
        "evaluator_sha256",
        "config_sha256",
        "initial_incumbent_sha256",
        "state_namespace",
        "slots",
        "observed_input_tokens",
        "observed_output_tokens",
        "wall_seconds",
        "resume_consistent"
      ],
      "title": "ArmRun",
      "type": "object"
    },
    "P2R1RunManifest": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "command_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Sha256",
          "type": "string"
        },
        "executor_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Executor Commit",
          "type": "string"
        },
        "protocol_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protocol Sha256",
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/P2R1RunSpec"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Start Manifest Sha256",
          "type": "string"
        },
        "task_asset_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Task Asset Hashes",
          "type": "object"
        }
      },
      "required": [
        "protocol_sha256",
        "executor_commit",
        "start_manifest_sha256",
        "run",
        "command",
        "command_sha256",
        "task_asset_hashes"
      ],
      "title": "P2R1RunManifest",
      "type": "object"
    },
    "P2R1RunReceipt": {
      "additionalProperties": false,
      "properties": {
        "analysis_run": {
          "$ref": "#/$defs/ArmRun"
        },
        "arm": {
          "enum": [
            "official",
            "native"
          ],
          "title": "Arm",
          "type": "string"
        },
        "block": {
          "title": "Block",
          "type": "integer"
        },
        "database_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Database Sha256",
          "type": "string"
        },
        "executor_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Executor Commit",
          "type": "string"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "finished_at": {
          "title": "Finished At",
          "type": "string"
        },
        "paired_local_seed": {
          "title": "Paired Local Seed",
          "type": "integer"
        },
        "protocol_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protocol Sha256",
          "type": "string"
        },
        "resume_semantics": {
          "const": "RECEIPT_AND_DATABASE_DETERMINISTIC_NO_COMPLETED_SLOT_RERUN",
          "default": "RECEIPT_AND_DATABASE_DETERMINISTIC_NO_COMPLETED_SLOT_RERUN",
          "title": "Resume Semantics",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "run_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Manifest Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_slots": {
          "items": {
            "$ref": "#/$defs/P2R1ScientificSlotReceipt"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Scientific Slots",
          "type": "array"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "state_namespace": {
          "title": "State Namespace",
          "type": "string"
        },
        "transport_ledger_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Transport Ledger Sha256",
          "type": "string"
        },
        "wall_seconds": {
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "required": [
        "protocol_sha256",
        "executor_commit",
        "run_id",
        "block",
        "arm",
        "paired_local_seed",
        "state_namespace",
        "run_manifest_sha256",
        "exit_code",
        "started_at",
        "finished_at",
        "wall_seconds",
        "transport_ledger_sha256",
        "analysis_run",
        "scientific_slots",
        "database_sha256"
      ],
      "title": "P2R1RunReceipt",
      "type": "object"
    },
    "P2R1RunSpec": {
      "additionalProperties": false,
      "properties": {
        "arm": {
          "enum": [
            "official",
            "native"
          ],
          "title": "Arm",
          "type": "string"
        },
        "audit_dir": {
          "title": "Audit Dir",
          "type": "string"
        },
        "block": {
          "maximum": 10,
          "minimum": 1,
          "title": "Block",
          "type": "integer"
        },
        "database_path": {
          "title": "Database Path",
          "type": "string"
        },
        "paired_local_seed": {
          "title": "Paired Local Seed",
          "type": "integer"
        },
        "position_in_block": {
          "maximum": 2,
          "minimum": 1,
          "title": "Position In Block",
          "type": "integer"
        },
        "results_dir": {
          "title": "Results Dir",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sequence": {
          "maximum": 20,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/P2R1SlotSpec"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Slots",
          "type": "array"
        },
        "state_namespace": {
          "title": "State Namespace",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "sequence",
        "block",
        "position_in_block",
        "arm",
        "paired_local_seed",
        "state_namespace",
        "results_dir",
        "database_path",
        "audit_dir",
        "slots"
      ],
      "title": "P2R1RunSpec",
      "type": "object"
    },
    "P2R1Schedule": {
      "additionalProperties": false,
      "properties": {
        "protocol_id": {
          "const": "SHINKA_NATIVE_P2_R1",
          "title": "Protocol Id",
          "type": "string"
        },
        "protocol_sha256": {
          "pattern": "^[0-9a-f]{64}$",
