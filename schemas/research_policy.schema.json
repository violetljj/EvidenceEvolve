{
  "$defs": {
    "AcquisitionWeights": {
      "additionalProperties": false,
      "properties": {
        "admit_probability": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Admit Probability",
          "type": "number"
        },
        "cost": {
          "default": 0.5,
          "minimum": 0.0,
          "title": "Cost",
          "type": "number"
        },
        "expected_improvement": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Expected Improvement",
          "type": "number"
        },
        "information_gain": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Information Gain",
          "type": "number"
        },
        "novelty": {
          "default": 0.5,
          "minimum": 0.0,
          "title": "Novelty",
          "type": "number"
        },
        "redundancy": {
          "default": 0.5,
          "minimum": 0.0,
          "title": "Redundancy",
          "type": "number"
        },
        "transfer_value": {
          "default": 0.25,
          "minimum": 0.0,
          "title": "Transfer Value",
          "type": "number"
        }
      },
      "title": "AcquisitionWeights",
      "type": "object"
    },
    "MutationType": {
      "enum": [
        "mechanism_mutation",
        "representation_mutation",
        "failure_directed_mutation",
        "control_mutation",
        "simplification",
        "cross_family",
        "restart"
      ],
      "title": "MutationType",
      "type": "string"
    },
    "SearchDisposition": {
      "description": "Scheduling value that is deliberately separate from scientific authority.",
      "enum": [
        "CODE_PARENT",
        "FAILURE_DIRECTED_SEED",
        "IDEA_INSPIRATION",
        "QUARANTINE"
      ],
      "title": "SearchDisposition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "breakthrough_mutation_mix": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "$ref": "#/$defs/MutationType"
      },
      "title": "Breakthrough Mutation Mix",
      "type": "object"
    },
    "code_parent_dispositions": {
      "items": {
        "$ref": "#/$defs/SearchDisposition"
      },
      "title": "Code Parent Dispositions",
      "type": "array"
    },
    "context_compiler": {
      "const": "lineage_plus_failure_signature",
      "default": "lineage_plus_failure_signature",
      "title": "Context Compiler",
      "type": "string"
    },
    "island_capacity": {
      "default": 32,
      "minimum": 1,
      "title": "Island Capacity",
      "type": "integer"
    },
    "island_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Island Ids",
      "type": "array"
    },
    "max_parallel_evaluations": {
      "default": 1,
      "maximum": 32,
      "minimum": 1,
      "title": "Max Parallel Evaluations",
      "type": "integer"
    },
    "max_parallel_proposals": {
      "default": 1,
      "maximum": 32,
      "minimum": 1,
      "title": "Max Parallel Proposals",
      "type": "integer"
    },
    "migration_count": {
      "default": 1,
      "minimum": 0,
      "title": "Migration Count",
      "type": "integer"
    },
    "migration_interval": {
      "default": 3,
      "minimum": 1,
      "title": "Migration Interval",
      "type": "integer"
    },
    "moonshot_fraction": {
      "default": 0.1,
      "maximum": 0.5,
      "minimum": 0.0,
      "title": "Moonshot Fraction",
      "type": "number"
    },
    "mutation_operator_mix": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "$ref": "#/$defs/MutationType"
      },
      "title": "Mutation Operator Mix",
      "type": "object"
    },
    "parent_selector": {
      "const": "island_stratified",
      "default": "island_stratified",
      "title": "Parent Selector",
      "type": "string"
    },
    "parents_per_island": {
      "default": 4,
      "minimum": 1,
      "title": "Parents Per Island",
      "type": "integer"
    },
    "policy_id": {
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stagnation_generations": {
      "default": 3,
      "minimum": 1,
      "title": "Stagnation Generations",
      "type": "integer"
    },
    "stagnation_response": {
      "const": "cross_family_structural_restart",
      "default": "cross_family_structural_restart",
      "title": "Stagnation Response",
      "type": "string"
    },
    "stepping_stone_min_information_gain": {
      "default": 0.6,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Stepping Stone Min Information Gain",
      "type": "number"
    },
    "weights": {
      "$ref": "#/$defs/AcquisitionWeights"
    }
  },
  "required": [
    "policy_id"
  ],
  "title": "ResearchPolicyGenome",
  "type": "object"
}
